# ─── Aurelle Cabs — Customer Website ─────────────────────────────────────────
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# MongoDB connection string (shared with the admin project).
# If unset or unreachable, the app runs on an in-memory demo store that resets on restart.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aurelle_cabs?retryWrites=true&w=majority

# Secret used to sign customer login tokens. Use a long random string,
# and a DIFFERENT value from the admin project's JWT_SECRET.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Only set to "true" if a corporate proxy re-signs TLS traffic to MongoDB.
MONGODB_TLS_ALLOW_INVALID=false
